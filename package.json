{
  "name": "tribeosbot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @tribeos/database migrate:dev",
    "db:generate": "pnpm --filter @tribeos/database generate",
    "db:studio": "pnpm --filter @tribeos/database studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
