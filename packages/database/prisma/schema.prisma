generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  telegramId    String?   @unique
  lastLoginIp   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  groupAdmins   GroupAdmin[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Telegram Groups ──────────────────────────────────────────────────────────

model TelegramGroup {
  id              String   @id @default(cuid())
  telegramId      String   @unique
  title           String
  username        String?
  type            String   @default("supergroup")
  memberCount     Int?
  isActive        Boolean  @default(true)
  botIsAdmin      Boolean  @default(false)
  linkedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  admins          GroupAdmin[]
  moduleConfigs   GroupModuleConfig[]
  campaigns       Campaign[]
  linkChallenges  GroupLinkChallenge[]
  inviteLinks     ReferralInviteLink[]
  announcements   Announcement[]
  auditLogs       AuditLog[]
  flashBounties   FlashBounty[]
  mysteryBoxes    MysteryBox[]
  poachEvents     PoachEvent[]
  quests          Quest[]
  badges          Badge[]

  @@map("telegram_groups")
}

model GroupAdmin {
  id            String         @id @default(cuid())
  groupId       String
  userId        String
  role          GroupAdminRole @default(ADMIN)
  verifiedAt    DateTime       @default(now())
  telegramUserId String?

  group TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_admins")
}

enum GroupAdminRole {
  OWNER
  ADMIN
  VIEWER
}

model GroupLinkChallenge {
  id          String    @id @default(cuid())
  code        String    @unique
  userId      String
  groupId     String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  group TelegramGroup? @relation(fields: [groupId], references: [id])

  @@map("group_link_challenges")
}

// ─── Module System ────────────────────────────────────────────────────────────

model GroupModuleConfig {
  id          String   @id @default(cuid())
  groupId     String
  moduleId    String
  enabled     Boolean  @default(false)
  config      Json     @default("{}")
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  group        TelegramGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  configHistory ConfigVersion[]

  @@unique([groupId, moduleId])
  @@map("group_module_configs")
}

model ConfigVersion {
  id             String   @id @default(cuid())
  moduleConfigId String
  config         Json
  version        Int
  changedBy      String?
  createdAt      DateTime @default(now())

  moduleConfig GroupModuleConfig @relation(fields: [moduleConfigId], references: [id], onDelete: Cascade)

  @@map("config_versions")
}

// ─── Campaigns ────────────────────────────────────────────────────────────────

model Campaign {
  id                      String         @id @default(cuid())
  groupId                 String
  name                    String
  description             String?        @db.Text
  status                  CampaignStatus @default(DRAFT)
  startAt                 DateTime
  endAt                   DateTime
  timezone                String         @default("UTC")
  maxParticipants         Int?
  pointsPerReferral       Int            @default(1)
  qualificationRules      Json           @default("{}")
  rewardStructure         Json?
  rules                   String?        @db.Text
  contestReviewPeriodHours Int           @default(48)
  finalizedAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  createdBy               String?

  group         TelegramGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants  CampaignParticipant[]
  referralCodes ReferralCode[]
  referrals     Referral[]
  rewardPools   RewardPool[]
  auditLogs     AuditLog[]
  inviteLinks   ReferralInviteLink[]
  flashBounties FlashBounty[]
  mysteryBoxes  MysteryBox[]
  poachEvents   PoachEvent[]
  teams         Team[]
  quests        Quest[]
  announcements Announcement[]

  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

// ─── Participants ─────────────────────────────────────────────────────────────

model CampaignParticipant {
  id              String   @id @default(cuid())
  campaignId      String
  telegramUserId  String
  telegramUsername String?
  telegramName    String?
  registeredAt    DateTime @default(now())
  isGroupMember   Boolean  @default(false)
  memberSince     DateTime?
  totalPoints     Int      @default(0)
  qualifiedReferrals Int   @default(0)
  pendingReferrals   Int   @default(0)
  rank            Int?

  lastActiveAt         DateTime?
  inactivityAlertedAt  DateTime?

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  referralCode ReferralCode?
  referralsGiven    Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("Referred")
  questCompletions  QuestCompletion[]
  userBadges        UserBadge[]
  teamMemberships   TeamMembership[]

  @@unique([campaignId, telegramUserId])
  @@map("campaign_participants")
}

// ─── Referral Codes ───────────────────────────────────────────────────────────

model ReferralCode {
  id            String   @id @default(cuid())
  campaignId    String
  participantId String   @unique
  code          String   @unique
  deepLink      String
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())

  campaign    Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  participant CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  referrals   Referral[]
  inviteLinks ReferralInviteLink[]

  @@map("referral_codes")
}

// ─── Referrals ────────────────────────────────────────────────────────────────

model Referral {
  id                 String         @id @default(cuid())
  campaignId         String
  referrerId         String
  referredId         String
  referralCodeId     String
  status             ReferralStatus @default(REGISTERED)
  attributionSource  String         @default("deep_link")
  qualifiedAt        DateTime?
  rejectedAt         DateTime?
  reversedAt         DateTime?
  rejectionReason    String?
  reversalReason     String?
  pointsAwarded      Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  idempotencyKey     String?        @unique

  campaign    Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  referrer    CampaignParticipant @relation("Referrer", fields: [referrerId], references: [id])
  referred    CampaignParticipant @relation("Referred", fields: [referredId], references: [id])
  referralCode ReferralCode       @relation(fields: [referralCodeId], references: [id])
  qualChecks  QualificationCheck[]
  mysteryBox  MysteryBox?

  @@unique([campaignId, referredId])
  @@map("referrals")
}

enum ReferralStatus {
  REGISTERED
  PENDING
  QUALIFIED
  REJECTED
  REVERSED
}

// ─── Qualification Checks ─────────────────────────────────────────────────────

model QualificationCheck {
  id          String   @id @default(cuid())
  referralId  String
  checkType   String
  passed      Boolean
  evidence    Json?
  checkedAt   DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@map("qualification_checks")
}

// ─── Telegram Events ──────────────────────────────────────────────────────────

model TelegramEvent {
  id              String   @id @default(cuid())
  updateId        BigInt   @unique
  eventType       String
  telegramGroupId String?
  telegramUserId  String?
  payload         Json
  processedAt     DateTime @default(now())

  @@map("telegram_events")
}

// ─── Referral Invite Links ────────────────────────────────────────────────────

model ReferralInviteLink {
  id                  String   @id @default(cuid())
  groupId             String
  campaignId          String
  referralCodeId      String
  inviteLink          String   @unique
  telegramLinkId      String?
  requiresJoinRequest Boolean  @default(false)
  approvedCount       Int      @default(0)
  pendingCount        Int      @default(0)
  expiresAt           DateTime?
  createdAt           DateTime @default(now())

  group        TelegramGroup @relation(fields: [groupId], references: [id])
  campaign     Campaign      @relation(fields: [campaignId], references: [id])
  referralCode ReferralCode  @relation(fields: [referralCodeId], references: [id])

  @@map("referral_invite_links")
}

// ─── Flash Bounties ───────────────────────────────────────────────────────────

model FlashBounty {
  id                String            @id @default(cuid())
  groupId           String
  campaignId        String?
  startedBy         String
  durationMinutes   Int               @default(60)
  multiplier        Float             @default(3.0)
  bonusPoints       Int               @default(0)
  startAt           DateTime
  endAt             DateTime
  inviteCount       Int               @default(0)
  status            FlashBountyStatus @default(ACTIVE)
  telegramMessageId String?
  createdAt         DateTime          @default(now())

  group    TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  campaign Campaign?     @relation(fields: [campaignId], references: [id])

  @@index([groupId, status])
  @@map("flash_bounties")
}

enum FlashBountyStatus {
  ACTIVE
  ENDED
  CANCELLED
}

// ─── Mystery Boxes ────────────────────────────────────────────────────────────

model MysteryBox {
  id                String           @id @default(cuid())
  groupId           String
  campaignId        String
  inviterId         String
  inviteeId         String
  referralId        String           @unique
  rewardDescription String
  inviterClaimedAt  DateTime?
  inviteeClaimedAt  DateTime?
  destroyedAt       DateTime?
  expiresAt         DateTime
  status            MysteryBoxStatus @default(PENDING)
  telegramMessageId String?
  createdAt         DateTime         @default(now())

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group    TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  referral Referral      @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
  @@map("mystery_boxes")
}

enum MysteryBoxStatus {
  PENDING
  PARTIALLY_CLAIMED
  CLAIMED
  DESTROYED
}

// ─── Poach Events ─────────────────────────────────────────────────────────────

model PoachEvent {
  id                   String           @id @default(cuid())
  groupId              String
  campaignId           String
  subjectTelegramId    String
  originalReferrerId   String
  poacherId            String?
  alertMessageId       String?
  alertSentAt          DateTime         @default(now())
  poachClaimedAt       DateTime?
  pointsTransferred    Int              @default(0)
  expiresAt            DateTime
  status               PoachEventStatus @default(ALERTING)

  group    TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
  @@index([campaignId, subjectTelegramId])
  @@map("poach_events")
}

enum PoachEventStatus {
  ALERTING
  CLAIMED
  EXPIRED
}

// ─── Teams ────────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  campaignId  String
  name        String
  description String?
  region      String?
  totalPoints Int      @default(0)
  createdAt   DateTime @default(now())

  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  memberships TeamMembership[]

  @@map("teams")
}

model TeamMembership {
  id            String   @id @default(cuid())
  teamId        String
  participantId String
  joinedAt      DateTime @default(now())

  team        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([teamId, participantId])
  @@map("team_memberships")
}

// ─── Rewards ──────────────────────────────────────────────────────────────────

model RewardPool {
  id          String   @id @default(cuid())
  campaignId  String
  name        String
  description String?
  totalAmount Decimal? @db.Decimal(20, 8)
  currency    String?
  rewardType  String   @default("POINTS")
  createdAt   DateTime @default(now())

  campaign    Campaign          @relation(fields: [campaignId], references: [id])
  allocations RewardAllocation[]

  @@map("reward_pools")
}

model RewardAllocation {
  id            String       @id @default(cuid())
  poolId        String
  participantId String
  amount        Decimal?     @db.Decimal(20, 8)
  points        Int?
  rank          Int?
  status        RewardStatus @default(PENDING)
  claimedAt     DateTime?
  paidAt        DateTime?
  paymentRef    String?
  notes         String?
  createdAt     DateTime     @default(now())

  pool RewardPool @relation(fields: [poolId], references: [id])

  @@map("reward_allocations")
}

enum RewardStatus {
  PENDING
  ELIGIBLE
  CLAIMED
  PAID
  REJECTED
}

// ─── Announcements ────────────────────────────────────────────────────────────

model Announcement {
  id          String    @id @default(cuid())
  groupId     String
  campaignId  String?
  content     String    @db.Text
  type        String    @default("BROADCAST")
  scheduledAt DateTime?
  sentAt      DateTime?
  status      String    @default("DRAFT")
  createdBy   String?
  createdAt   DateTime  @default(now())

  group    TelegramGroup @relation(fields: [groupId], references: [id])
  campaign Campaign?     @relation(fields: [campaignId], references: [id])

  @@map("announcements")
}

// ─── Quests & Badges ──────────────────────────────────────────────────────────

model Quest {
  id          String   @id @default(cuid())
  groupId     String
  campaignId  String?
  title       String
  description String?  @db.Text
  type        String   @default("MANUAL")
  target      Int      @default(1)
  points      Int      @default(10)
  badgeId     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  group       TelegramGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  campaign    Campaign?        @relation(fields: [campaignId], references: [id])
  badge       Badge?           @relation(fields: [badgeId], references: [id])
  completions QuestCompletion[]

  @@map("quests")
}

model QuestCompletion {
  id            String   @id @default(cuid())
  questId       String
  participantId String
  completedAt   DateTime @default(now())
  pointsAwarded Int      @default(0)

  quest       Quest               @relation(fields: [questId], references: [id], onDelete: Cascade)
  participant CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([questId, participantId])
  @@map("quest_completions")
}

model Badge {
  id          String   @id @default(cuid())
  groupId     String
  name        String
  description String?
  emoji       String   @default("🏆")
  rarity      String   @default("COMMON")
  createdAt   DateTime @default(now())

  group  TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  quests Quest[]
  awards UserBadge[]

  @@map("badges")
}

model UserBadge {
  id            String   @id @default(cuid())
  badgeId       String
  participantId String
  awardedAt     DateTime @default(now())
  note          String?

  badge       Badge               @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  participant CampaignParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([badgeId, participantId])
  @@map("user_badges")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  groupId     String?
  campaignId  String?
  userId      String?
  eventType   String
  description String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  group    TelegramGroup? @relation(fields: [groupId], references: [id])
  campaign Campaign?      @relation(fields: [campaignId], references: [id])
  user     User?          @relation(fields: [userId], references: [id])

  @@index([groupId])
  @@index([campaignId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Job Outbox (pg-boss compatible) ─────────────────────────────────────────

model JobOutbox {
  id          String    @id @default(cuid())
  jobName     String
  payload     Json
  status      String    @default("PENDING")
  scheduledAt DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@map("job_outbox")
}
