# Local development values. On Railway these are defined in .railway/railway.ts.

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
BOT_TOKEN="your-telegram-bot-token-from-botfather"
BOT_USERNAME="YourBotUsername"

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/tribeosbot_dev"
# Caps Prisma's connection pool (Railway sets 5 for the bot)
DB_CONNECTION_LIMIT=""

# ─── Webhook mode ─────────────────────────────────────────────────────────────
# Leave WEBHOOK_URL empty locally to use long polling. On Railway it's derived from
# RAILWAY_PUBLIC_DOMAIN automatically. Webhook mode refuses to start without a secret.
WEBHOOK_URL=""
BOT_WEBHOOK_SECRET=""

# ─── Dashboard ────────────────────────────────────────────────────────────────
# Public HTTPS URL of the web app. HTTPS enables the "Open App" Mini App buttons.
DASHBOARD_URL="http://localhost:3000"

# ─── Error monitoring (optional) ──────────────────────────────────────────────
SENTRY_DSN=""
