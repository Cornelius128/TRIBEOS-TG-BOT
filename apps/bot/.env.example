# ─── Telegram Bot ─────────────────────────────────────────────────────────────
BOT_TOKEN="your-telegram-bot-token-from-botfather"
BOT_USERNAME="YourBotUsername"

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/tribeosbot_dev"

# ─── Webhook ──────────────────────────────────────────────────────────────────
# Secret used as both the Telegram webhook secret token AND as the URL path suffix.
# Must match the secret part of BOT_WEBHOOK_URL in apps/web/.env.
# e.g. if BOT_WEBHOOK_SECRET=abc123, the bot listens at /webhook/abc123
BOT_WEBHOOK_SECRET="your-webhook-secret"

# Port the bot's Express server listens on (webhook mode)
PORT="3001"

# ─── App ──────────────────────────────────────────────────────────────────────
DASHBOARD_URL="http://localhost:3000"
