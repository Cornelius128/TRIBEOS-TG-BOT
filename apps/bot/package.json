{
  "name": "@tribeos/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter @tribeos/database generate && tsc",
    "start": "pnpm --filter @tribeos/database migrate:deploy && node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@prisma/client": "^6.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^11.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.34.0",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
