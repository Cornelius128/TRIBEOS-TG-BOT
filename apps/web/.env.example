# Local development values. On Railway these are defined in .railway/railway.ts.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/tribeosbot_dev"
# Caps Prisma's connection pool (Railway sets 10 for web)
DB_CONNECTION_LIMIT=""

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-at-least-32-chars"

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Same token as the bot — used to verify Telegram Mini App initData
TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token"
# Bot username without @
BOT_USERNAME="TribeOSBot"
NEXT_PUBLIC_BOT_USERNAME="TribeOSBot"

# ─── Error monitoring (optional) ──────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
